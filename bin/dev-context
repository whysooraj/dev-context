#!/usr/bin/env python3
"""
dev-context: Instant pre-flight context dashboard & task manager for terminal coding agents.
Scans active repositories, uncommitted working trees, and pending roadmaps.
"""

import os
import sys
import json
import time
import re
import hashlib
import argparse
import subprocess
import concurrent.futures
import shutil
import uuid
import threading
from contextlib import contextmanager

try:
    import fcntl
except ImportError:
    fcntl = None

try:
    import msvcrt
except ImportError:
    msvcrt = None

# ANSI styling
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
CYAN = "\033[36m"
WHITE = "\033[37m"
RED = "\033[31m"

SKIP_DIRS = {
    "node_modules",
    ".cache",
    ".cargo",
    ".local",
    "dist",
    "build",
    "venv",
    ".venv",
    "target",
    ".git",
}

def is_git_repo(path):
    """
    Check if path is a Git repository or worktree.
    Supports regular .git directories and worktree .git files containing 'gitdir: ...'.
    """
    try:
        git_path = os.path.join(path, ".git")
        if os.path.isdir(git_path):
            return True
        if os.path.isfile(git_path):
            with open(git_path, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read(512)
                return any(line.strip().startswith("gitdir:") for line in content.splitlines())
    except Exception:
        return False
    return False

def find_repo_root(path=None):
    """
    Find top-level Git repository root containing path by walking up directory tree.
    """
    if path is None:
        path = os.getcwd()
    path = os.path.realpath(os.path.abspath(path))
    cur = path
    while True:
        if is_git_repo(cur):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    return None

def find_git_repos(base_dir, max_depth=3):
    """
    Scan directories up to max_depth under base_dir to find Git repositories and worktrees.
    Skips node_modules, .cache, .cargo, .local, dist, build, venv, target, and .git.
    """
    repos = []
    base_dir = os.path.abspath(base_dir)
    if not os.path.isdir(base_dir):
        return repos

    for root, dirs, files in os.walk(base_dir, followlinks=False):
        rel = os.path.relpath(root, base_dir)
        depth = 0 if rel == "." else len(rel.split(os.sep))

        if depth > 0 and is_git_repo(root):
            repos.append(root)

        if depth >= max_depth:
            dirs.clear()
            continue

        dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith(".git")]

    return sorted(list(dict.fromkeys(repos)))

def get_git_info(path, timeout=5):
    """
    Inspect git repository / worktree details with timeout safeguard.
    Returns dictionary with branch, timestamp, rel_time, subject, dirty_count, dirty_lines.
    """
    try:
        if not is_git_repo(path):
            return None

        # 1. Current branch
        try:
            branch = subprocess.check_output(
                ["git", "-C", path, "branch", "--show-current"],
                stderr=subprocess.DEVNULL,
                timeout=timeout
            ).decode("utf-8", "ignore").strip() or "HEAD"
        except subprocess.TimeoutExpired:
            raise
        except FileNotFoundError:
            return None
        except Exception:
            branch = "HEAD"

        # 2. Last commit log
        try:
            log_out = subprocess.check_output(
                ["git", "-C", path, "log", "-1", "--format=%ct|%cr|%s"],
                stderr=subprocess.DEVNULL,
                timeout=timeout
            ).decode("utf-8", "ignore").strip()
            ts, cr, subj = log_out.split("|", 2) if log_out else ("0", "", "")
        except subprocess.TimeoutExpired:
            raise
        except FileNotFoundError:
            return None
        except Exception:
            ts, cr, subj = "0", "", ""

        # 3. Status porcelain
        try:
            status_out = subprocess.check_output(
                ["git", "-C", path, "status", "--porcelain"],
                stderr=subprocess.DEVNULL,
                timeout=timeout
            ).decode("utf-8", "ignore").strip()
            status_lines = status_out.splitlines() if status_out else []
        except subprocess.TimeoutExpired:
            raise
        except FileNotFoundError:
            return None
        except Exception:
            status_lines = []

        return {
            "branch": branch,
            "timestamp": int(ts) if ts.isdigit() else 0,
            "rel_time": cr,
            "subject": subj,
            "dirty_count": len(status_lines),
            "dirty_lines": status_lines[:4],
            "path": path,
        }
    except Exception:
        return None

def scan_repositories(base_dir, max_depth=3, max_workers=None, per_repo_timeout=5, total_timeout=None):
    """
    Discover all repositories under base_dir up to max_depth and inspect them in parallel.
    Uses concurrent.futures.ThreadPoolExecutor with timeout safeguards.
    """
    repo_paths = find_git_repos(base_dir, max_depth=max_depth)
    if not repo_paths:
        return []

    if total_timeout is None:
        total_timeout = max(30.0, len(repo_paths) * 0.1)

    if max_workers is None:
        cpu = os.cpu_count() or 4
        max_workers = min(32, max(4, cpu * 2))

    repo_data = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
        future_to_path = {
            executor.submit(get_git_info, path, per_repo_timeout): path
            for path in repo_paths
        }
        try:
            for future in concurrent.futures.as_completed(future_to_path, timeout=total_timeout):
                path = future_to_path[future]
                try:
                    info = future.result()
                    if info:
                        rel_name = os.path.relpath(path, base_dir)
                        info["name"] = rel_name
                        repo_data[path] = (rel_name, info)
                except Exception:
                    pass
        except concurrent.futures.TimeoutError:
            for f in future_to_path:
                f.cancel()

    results = list(repo_data.values())
    results.sort(key=lambda x: x[1]["timestamp"], reverse=True)
    return results

TASK_LINE_REGEX = re.compile(r'^(\s*[-*]\s*\[)([ xX\-~!\?])(\]\s*)(.*)$')
ID_COMMENT_REGEX = re.compile(r'<!--\s*id:([0-9a-fA-F]{4,8})\s*-->')
ID_CARET_REGEX = re.compile(r'\^([0-9a-fA-F]{4,8})\b')

def generate_task_id(text, existing_ids=None):
    """Generate a unique 4-character hex ID tag."""
    if existing_ids is None:
        existing_ids = set()
    seed = f"{text}{time.time()}{os.urandom(4).hex()}"
    task_id = hashlib.sha256(seed.encode("utf-8")).hexdigest()[:4].lower()
    counter = 0
    while task_id in existing_ids:
        counter += 1
        task_id = hashlib.sha256(f"{seed}_{counter}".encode("utf-8")).hexdigest()[:4].lower()
    return task_id

def fallback_task_id(text):
    """Deterministic 4-hex ID derived from clean task text for existing tasks lacking ID tags."""
    cleaned = ID_COMMENT_REGEX.sub('', text)
    cleaned = ID_CARET_REGEX.sub('', cleaned).strip()
    return hashlib.sha256(cleaned.encode("utf-8")).hexdigest()[:4].lower()

def extract_project(text):
    """
    Extract project tag from task text if present.
    Supports (project), [project], project:, and #project.
    """
    if not text:
        return None
    m = re.match(r'^\s*\(([^)]+)\)', text)
    if m:
        return m.group(1).strip()
    m = re.match(r'^\s*\[([^\]]+)\]', text)
    if m:
        return m.group(1).strip()
    m = re.match(r'^\s*([a-zA-Z0-9_\-]+):', text)
    if m:
        word = m.group(1).strip()
        if word.upper() not in ("TODO", "FIXME", "NOTE", "BUG", "TASK"):
            return word
    m = re.search(r'#([a-zA-Z0-9_\-]+)\b', text)
    if m:
        return m.group(1).strip()
    return None

def format_state_badge(state, color=True):
    """Format human-readable state badge."""
    if state == "in_progress":
        return f"{YELLOW}[IN-PROGRESS]{RESET}" if color else "[IN-PROGRESS]"
    elif state == "blocked":
        return f"{RED}[BLOCKED]{RESET}" if color else "[BLOCKED]"
    elif state == "completed":
        return f"{GREEN}[DONE]{RESET}" if color else "[DONE]"
    else:
        return f"{CYAN}[TODO]{RESET}" if color else "[TODO]"

_lock_thread_local = threading.local()

@contextmanager
def session_file_lock(lock_path, timeout=5.0, retry_delay=0.02):
    """
    Cross-platform advisory file lock:
    - POSIX (Linux / macOS): fcntl.flock(LOCK_EX | LOCK_NB)
    - Windows (NT): msvcrt.locking(LK_NBLCK)
    Includes timeout, retry loop, and thread-local reentrancy support.
    """
    abs_lock_path = os.path.abspath(lock_path)
    active_locks = getattr(_lock_thread_local, "active_locks", None)
    if active_locks is None:
        active_locks = {}
        _lock_thread_local.active_locks = active_locks

    if active_locks.get(abs_lock_path, 0) > 0:
        active_locks[abs_lock_path] += 1
        try:
            yield
        finally:
            active_locks[abs_lock_path] -= 1
        return

    parent_dir = os.path.dirname(abs_lock_path)
    if parent_dir:
        try:
            os.makedirs(parent_dir, exist_ok=True)
        except Exception:
            pass

    start_time = time.time()
    try:
        lock_fd = os.open(abs_lock_path, os.O_RDWR | os.O_CREAT, 0o600)
    except Exception:
        yield
        return

    try:
        while True:
            try:
                if fcntl is not None:
                    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                elif msvcrt is not None:
                    os.lseek(lock_fd, 0, os.SEEK_SET)
                    msvcrt.locking(lock_fd, msvcrt.LK_NBLCK, 1)
                break
            except (BlockingIOError, OSError, PermissionError):
                if (time.time() - start_time) >= timeout:
                    yield
                    return
                time.sleep(retry_delay)

        active_locks[abs_lock_path] = 1
        try:
            yield
        finally:
            active_locks[abs_lock_path] = 0
            try:
                if fcntl is not None:
                    fcntl.flock(lock_fd, fcntl.LOCK_UN)
                elif msvcrt is not None:
                    try:
                        os.lseek(lock_fd, 0, os.SEEK_SET)
                        msvcrt.locking(lock_fd, msvcrt.LK_UNLCK, 1)
                    except Exception:
                        pass
            except Exception:
                pass
    finally:
        try:
            os.close(lock_fd)
        except Exception:
            pass

@contextmanager
def roadmap_file_lock(roadmap_path, timeout=5.0, retry_delay=0.02):
    """POSIX file lock specifically for roadmap operations to prevent race conditions."""
    lock_path = os.path.abspath(roadmap_path) + ".lock"
    with session_file_lock(lock_path, timeout=timeout, retry_delay=retry_delay):
        yield

def atomic_write_text(target_path, content):
    """
    Atomically write text content to target_path using a temporary file in the same
    directory, flushing, fsyncing, and calling os.replace.
    """
    dir_name = os.path.dirname(os.path.abspath(target_path)) or "."
    os.makedirs(dir_name, exist_ok=True)
    tmp_path = os.path.join(dir_name, f".tmp.{os.getpid()}.{uuid.uuid4().hex[:8]}")
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            try:
                os.fsync(f.fileno())
            except Exception:
                pass
        os.replace(tmp_path, target_path)
    finally:
        if os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except Exception:
                pass

def find_roadmap_file(local_only=False, create_if_missing=False, cwd=None):
    env_roadmap = os.getenv("DEV_CONTEXT_ROADMAP_FILE")
    if env_roadmap and os.path.isfile(env_roadmap):
        return env_roadmap

    target_cwd = cwd or os.getcwd()
    in_git = is_git_repo(target_cwd)
    projects_base = os.getenv("DEV_CONTEXT_DIR", os.path.expanduser("~/Projects"))

    if local_only:
        p = os.path.join(target_cwd, "ROADMAP.md")
        if create_if_missing and not os.path.exists(p):
            with open(p, "w", encoding="utf-8") as f:
                f.write("# Project Roadmap\n\n## Active Sprint\n\n## Ideas Backlog\n")
        return p if os.path.isfile(p) else None

    candidates = [
        os.path.join(target_cwd, "ROADMAP.md") if in_git else None,
        os.path.join(target_cwd, "TODO.md") if in_git else None,
        os.path.join(projects_base, "ROADMAP.md"),
        os.path.expanduser("~/.roadmap.md"),
    ]
    found = next((p for p in candidates if p and os.path.isfile(p)), None)
    if not found and create_if_missing:
        os.makedirs(projects_base, exist_ok=True)
        default_path = os.path.join(projects_base, "ROADMAP.md")
        with open(default_path, "w", encoding="utf-8") as f:
            f.write("# Projects & Ideas Roadmap\n\n## Active Sprint\n\n## Ideas Backlog\n")
        return default_path
    return found

def get_open_tasks(file_path, include_completed=False):
    if not file_path or not os.path.isfile(file_path):
        return [], []
    with open(file_path, "r", encoding="utf-8") as f:
        lines = f.read().splitlines()

    tasks = []
    task_num = 1
    existing_ids = set()

    for idx, line in enumerate(lines):
        m = TASK_LINE_REGEX.match(line)
        if not m:
            continue

        state_char = m.group(2)
        content = m.group(4)

        if state_char in ('x', 'X'):
            state = "completed"
            state_label = "[DONE]"
        elif state_char in ('-', '~'):
            state = "in_progress"
            state_label = "[IN-PROGRESS]"
        elif state_char == '!':
            state = "blocked"
            state_label = "[BLOCKED]"
        else:
            state = "open"
            state_label = "[TODO]"

        id_match = ID_COMMENT_REGEX.search(content) or ID_CARET_REGEX.search(content)
        if id_match:
            task_id = id_match.group(1).lower()
            clean_text = ID_COMMENT_REGEX.sub('', content)
            clean_text = ID_CARET_REGEX.sub('', clean_text).strip()
        else:
            clean_text = content.strip()
            task_id = fallback_task_id(clean_text)
            if task_id in existing_ids:
                task_id = hashlib.sha256(f"{clean_text}_{idx}".encode("utf-8")).hexdigest()[:4].lower()

        existing_ids.add(task_id)
        project = extract_project(clean_text)

        num = None
        if state != "completed":
            num = task_num
            task_num += 1

        if not include_completed and state == "completed":
            continue

        tasks.append({
            "line_idx": idx,
            "task_num": num,
            "id": task_id,
            "state": state,
            "state_label": state_label,
            "project": project,
            "text": clean_text,
            "display_text": clean_text,
            "raw": line
        })

    return tasks, lines

def find_task(tasks, ref):
    """
    Find task by stable ID (case-insensitive) or 1-based numeric index.
    """
    if ref is None:
        return None
    ref_str = str(ref).strip().lower()

    # 1. Match stable ID
    for t in tasks:
        if t["id"].lower() == ref_str:
            return t

    # 2. Match numeric index
    if ref_str.isdigit():
        num = int(ref_str)
        for t in tasks:
            if t.get("task_num") == num:
                return t

    return None

def cmd_add(text, section="## Active Sprint", local=False, project=None, file_path=None, quiet=False):
    target_file = file_path or find_roadmap_file(local_only=local, create_if_missing=True)
    if not target_file:
        if not quiet:
            print(f"{RED}Could not locate or create roadmap file.{RESET}")
        return None

    cwd = os.getcwd()
    repo_root = find_repo_root(cwd)
    in_git = repo_root is not None
    current_repo = os.path.basename(repo_root) if in_git else None

    # Check if target_file is global roadmap
    is_global_roadmap = False
    if in_git:
        try:
            target_real = os.path.realpath(os.path.abspath(target_file))
            repo_real = os.path.realpath(os.path.abspath(repo_root))
            common = os.path.realpath(os.path.commonpath([target_real, repo_real]))
            is_global_roadmap = (common != repo_real)
        except ValueError:
            is_global_roadmap = True

    # Auto-scoping: if inside a git repo, default to tagging that project if writing to global roadmap
    if project is None and in_git and is_global_roadmap:
        project = current_repo

    if project:
        clean_proj = project.strip()
        if not (text.startswith(f"({clean_proj})") or text.startswith(f"[{clean_proj}]") or text.startswith(f"{clean_proj}:")):
            text = f"({clean_proj}) {text}"

    with roadmap_file_lock(target_file):
        lines = []
        if os.path.isfile(target_file):
            with open(target_file, "r", encoding="utf-8") as f:
                lines = f.read().splitlines()

        existing_tasks, _ = get_open_tasks(target_file, include_completed=True)
        existing_ids = {t["id"] for t in existing_tasks if t.get("id")}
        task_id = generate_task_id(text, existing_ids)

        task_line = f"- [ ] {text} <!-- id:{task_id} -->"
        new_lines = []
        inserted = False
        section_found = False

        for line in lines:
            new_lines.append(line)
            if line.strip().lower() == section.lower() and not inserted:
                section_found = True
                new_lines.append(task_line)
                inserted = True

        if not inserted:
            if not section_found:
                new_lines.append(f"\n{section}")
            new_lines.append(task_line)

        atomic_write_text(target_file, "\n".join(new_lines) + "\n")

    scope_name = os.path.basename(target_file)
    if not quiet:
        print(f"{GREEN}✓ Added to {scope_name} ({section}) [{task_id}]:{RESET} {text}")
    return task_id

def _change_task_state(task_id=None, new_state=None, remove=False, action_verb="update", local=False, file_path=None, quiet=False):
    prog = os.path.basename(sys.argv[0])
    target_file = file_path or find_roadmap_file(local_only=local)
    if not target_file or not os.path.isfile(target_file):
        if not quiet:
            print(f"{RED}No roadmap file found. Create one with: {prog} add \"task\"{RESET}")
        return False

    tasks, lines = get_open_tasks(target_file, include_completed=True)
    if not tasks:
        if not quiet:
            print(f"{CYAN}No tasks found in {os.path.basename(target_file)}!{RESET}")
        return False

    if task_id is None:
        if quiet:
            return False
        open_tasks = [t for t in tasks if t["state"] != "completed"]
        if not open_tasks:
            print(f"{CYAN}No open tasks found in {os.path.basename(target_file)}!{RESET}")
            return False
        cmd_list(local=local, file_path=target_file)
        try:
            choice = input(f"\nSelect task number or ID to {action_verb} [1-{len(open_tasks)}]: ").strip()
            task_id = choice
        except (ValueError, EOFError, KeyboardInterrupt):
            print("\nAborted.")
            return False

    with roadmap_file_lock(target_file):
        # Refresh tasks and lines under lock to prevent race conditions
        tasks, lines = get_open_tasks(target_file, include_completed=True)
        target_task = find_task(tasks, task_id)
        if not target_task:
            if not quiet:
                print(f"{RED}Task '{task_id}' not found. Run 'dev-context list' to see valid task numbers/IDs.{RESET}")
            return False

        idx = target_task["line_idx"]
        if remove:
            del lines[idx]
            if not quiet:
                print(f"{GREEN}✓ Deleted task [{target_task['id']}]:{RESET} {target_task['display_text']}")
        else:
            char_map = {
                "completed": "x",
                "in_progress": "-",
                "blocked": "!",
                "open": " ",
            }
            state_char = char_map.get(new_state, "x")
            line = lines[idx]
            m = TASK_LINE_REGEX.match(line)
            if m:
                prefix = m.group(1)
                closing = m.group(3)
                content = m.group(4)
                if not ID_COMMENT_REGEX.search(content) and not ID_CARET_REGEX.search(content):
                    content = f"{content.rstrip()} <!-- id:{target_task['id']} -->"
                lines[idx] = f"{prefix}{state_char}{closing}{content}"
            else:
                lines[idx] = f"- [{state_char}] {target_task['display_text']} <!-- id:{target_task['id']} -->"

            if not quiet:
                if new_state == "completed":
                    print(f"{GREEN}✓ Completed task [{target_task['id']}]:{RESET} {target_task['display_text']}")
                elif new_state == "in_progress":
                    print(f"{YELLOW}▶ Started task [{target_task['id']}]:{RESET} {target_task['display_text']}")
                elif new_state == "blocked":
                    print(f"{RED}✖ Blocked task [{target_task['id']}]:{RESET} {target_task['display_text']}")
                else:
                    print(f"{GREEN}✓ Updated task [{target_task['id']}]:{RESET} {target_task['display_text']}")

        atomic_write_text(target_file, "\n".join(lines) + "\n")
        return True

change_task_state = _change_task_state

def cmd_start(task_id=None, local=False, file_path=None, quiet=False):
    return _change_task_state(task_id=task_id, new_state="in_progress", action_verb="start", local=local, file_path=file_path, quiet=quiet)

def cmd_block(task_id=None, local=False, file_path=None, quiet=False):
    return _change_task_state(task_id=task_id, new_state="blocked", action_verb="block", local=local, file_path=file_path, quiet=quiet)

def cmd_done(task_id=None, remove=False, local=False, file_path=None, quiet=False):
    if remove:
        return _change_task_state(task_id=task_id, remove=True, action_verb="delete", local=local, file_path=file_path, quiet=quiet)
    return _change_task_state(task_id=task_id, new_state="completed", action_verb="mark done", local=local, file_path=file_path, quiet=quiet)

def cmd_rm(task_id=None, local=False, file_path=None, quiet=False):
    return cmd_done(task_id=task_id, remove=True, local=local, file_path=file_path, quiet=quiet)

def cmd_list(local=False, project=None, file_path=None):
    prog = os.path.basename(sys.argv[0])
    target_file = file_path or find_roadmap_file(local_only=local)
    if not target_file or not os.path.isfile(target_file):
        print(f"{RED}No roadmap file found.{RESET}")
        return []

    tasks, lines = get_open_tasks(target_file)

    if project:
        proj_lower = project.strip().lower()
        tasks = [
            t for t in tasks
            if (t.get("project") and t["project"].lower() == proj_lower)
            or f"({proj_lower})" in t["text"].lower()
            or f"[{proj_lower}]" in t["text"].lower()
            or t["text"].lower().startswith(f"{proj_lower}:")
            or f"#{proj_lower}" in t["text"].lower()
        ]
        print(f"\n{BOLD}📋 Open Tasks ({os.path.basename(target_file)}) [project: {project}]:{RESET}")
        if not tasks:
            print(f"   {DIM}No open tasks found for project '{project}'.{RESET}\n")
            return []
        for t in tasks:
            badge = format_state_badge(t["state"])
            print(f"   [{t['task_num']}] [{t['id']}] {badge} {t['display_text']}")
        print(f"{DIM}Done: {prog} done <id> | Start: {prog} start <id> | Block: {prog} block <id> | Delete: {prog} rm <id>{RESET}\n")
        return tasks

    print(f"\n{BOLD}📋 Open Tasks ({os.path.basename(target_file)}):{RESET}")
    if not tasks:
        print(f"   {DIM}All caught up! Add a task with: {prog} add \"...\"{RESET}\n")
        return []

    has_sections = any(line.strip().startswith("## ") for line in lines)
    if has_sections:
        task_by_line = {t["line_idx"]: t for t in tasks}
        for idx, line in enumerate(lines):
            stripped = line.strip()
            if stripped.startswith("## "):
                print(f"   {BOLD}{CYAN}{stripped}{RESET}")
            elif idx in task_by_line:
                t = task_by_line[idx]
                badge = format_state_badge(t["state"])
                print(f"   [{t['task_num']}] [{t['id']}] {badge} {t['display_text']}")
    else:
        for t in tasks:
            badge = format_state_badge(t["state"])
            print(f"   [{t['task_num']}] [{t['id']}] {badge} {t['display_text']}")

    print(f"\n{DIM}Done: {prog} done <id> | Start: {prog} start <id> | Block: {prog} block <id> | Delete: {prog} rm <id>{RESET}\n")
    return tasks

# ---------------------------------------------------------------------------
# Session Memory Engine
# ---------------------------------------------------------------------------

def get_session_file_path():
    """
    Determine the path to the sessions JSON file.
    Uses DEV_CONTEXT_SESSION_FILE if set.
    Otherwise uses ~/.config/dev-context/sessions.json,
    falling back to ~/.dev-context-sessions.json if ~/.config/dev-context is unwritable.
    """
    override = os.getenv("DEV_CONTEXT_SESSION_FILE")
    if override:
        return override

    primary_dir = os.path.expanduser("~/.config/dev-context")
    primary_file = os.path.join(primary_dir, "sessions.json")
    fallback_file = os.path.expanduser("~/.dev-context-sessions.json")

    try:
        os.makedirs(primary_dir, exist_ok=True)
        if os.access(primary_dir, os.W_OK):
            return primary_file
    except Exception:
        pass
    return fallback_file


def _backup_corrupted_file(path):
    """Backup corrupted session file with timestamp and random identifier."""
    try:
        if os.path.exists(path):
            backup_path = f"{path}.corrupted.{int(time.time())}.{uuid.uuid4().hex[:6]}"
            shutil.copy2(path, backup_path)
            return backup_path
    except Exception:
        pass
    return None


def load_sessions(file_path=None):
    """
    Load sessions dictionary from file under file lock.
    Returns safe default structure if file does not exist.
    If file is corrupted JSON, auto-recovers and backs up corrupted session file.
    """
    path = file_path or get_session_file_path()
    default_data = {"last_project": None, "projects": {}, "history": []}

    if not os.path.exists(path):
        if file_path is None:
            fallback = os.path.expanduser("~/.dev-context-sessions.json")
            if os.path.exists(fallback):
                path = fallback
            else:
                return default_data
        else:
            return default_data

    lock_path = f"{path}.lock"
    try:
        with session_file_lock(lock_path):
            with open(path, "r", encoding="utf-8") as f:
                content = f.read().strip()
                if not content:
                    return default_data
                data = json.loads(content)
                if not isinstance(data, dict):
                    _backup_corrupted_file(path)
                    return default_data
                data.setdefault("projects", {})
                data.setdefault("history", [])
                data.setdefault("last_project", None)
                return data
    except Exception:
        _backup_corrupted_file(path)
        return default_data


def save_sessions(data, file_path=None):
    """
    Save sessions dictionary to file atomically via temporary file (tmp.<pid>.<uuid>)
    and os.replace under POSIX file lock.
    Falls back to ~/.dev-context-sessions.json if primary path is not writable.
    """
    path = file_path or get_session_file_path()
    lock_path = f"{path}.lock"

    def _do_save(target_path):
        parent_dir = os.path.dirname(target_path)
        if parent_dir:
            os.makedirs(parent_dir, exist_ok=True)
        temp_path = f"{target_path}.tmp.{os.getpid()}.{uuid.uuid4().hex}"
        with open(temp_path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temp_path, target_path)
        return True

    try:
        with session_file_lock(lock_path):
            return _do_save(path)
    except Exception:
        if file_path is None:
            fallback_path = os.path.expanduser("~/.dev-context-sessions.json")
            if path != fallback_path:
                try:
                    with session_file_lock(f"{fallback_path}.lock"):
                        return _do_save(fallback_path)
                except Exception:
                    return False
        return False


def _parse_shortstat(stat_text):
    insertions = 0
    deletions = 0
    if not stat_text:
        return 0, 0
    m_ins = re.search(r"(\d+)\s+insertion", stat_text)
    if m_ins:
        insertions = int(m_ins.group(1))
    m_del = re.search(r"(\d+)\s+deletion", stat_text)
    if m_del:
        deletions = int(m_del.group(1))
    return insertions, deletions


def calculate_footprint(repo_path, timeout=5):
    """
    Calculate footprint (dirty diff statistics) using git diff --shortstat
    and git diff --cached --shortstat, plus list of modified/touched files.
    Returns tuple: (footprint_summary_str, list_of_recent_files)
    """
    if not is_git_repo(repo_path):
        return "clean", []

    recent_files = []
    total_ins = 0
    total_del = 0

    try:
        # 1. Unstaged changes
        try:
            unstaged_out = subprocess.check_output(
                ["git", "-C", repo_path, "diff", "--shortstat"],
                stderr=subprocess.DEVNULL,
                timeout=timeout
            ).decode("utf-8", "ignore").strip()
            ins, dels = _parse_shortstat(unstaged_out)
            total_ins += ins
            total_del += dels
        except Exception:
            pass

        # 2. Staged changes
        try:
            staged_out = subprocess.check_output(
                ["git", "-C", repo_path, "diff", "--cached", "--shortstat"],
                stderr=subprocess.DEVNULL,
                timeout=timeout
            ).decode("utf-8", "ignore").strip()
            ins, dels = _parse_shortstat(staged_out)
            total_ins += ins
            total_del += dels
        except Exception:
            pass

        # 3. Modified/touched files via git status --porcelain
        try:
            status_out = subprocess.check_output(
                ["git", "-C", repo_path, "status", "--porcelain"],
                stderr=subprocess.DEVNULL,
                timeout=timeout
            ).decode("utf-8", "ignore")
            for line in status_out.splitlines():
                if len(line) < 3:
                    continue
                file_part = line[2:].strip().strip('"')
                if " -> " in file_part:
                    file_part = file_part.split(" -> ")[-1].strip().strip('"')
                if file_part and file_part not in recent_files:
                    recent_files.append(file_part)
        except Exception:
            pass

    except Exception:
        return "clean", []

    if not recent_files and total_ins == 0 and total_del == 0:
        return "clean", []

    num_files = len(recent_files)
    file_word = "file" if num_files == 1 else "files"
    if total_ins > 0 or total_del > 0:
        footprint = f"+{total_ins} -{total_del} across {num_files} {file_word}"
    else:
        footprint = f"+0 -0 across {num_files} {file_word}"

    return footprint, recent_files


def format_rel_time(ts):
    """Format a unix timestamp into relative human time (e.g. '5 minutes ago')."""
    if not ts:
        return "never"
    diff = int(time.time() - ts)
    if diff < 60:
        return "just now"
    mins = diff // 60
    if mins < 60:
        return f"{mins} minute{'s' if mins != 1 else ''} ago"
    hours = mins // 60
    if hours < 24:
        return f"{hours} hour{'s' if hours != 1 else ''} ago"
    days = hours // 24
    if days < 30:
        return f"{days} day{'s' if days != 1 else ''} ago"
    months = days // 30
    if months < 12:
        return f"{months} month{'s' if months != 1 else ''} ago"
    years = days // 365
    return f"{years} year{'s' if years != 1 else ''} ago"


def update_session(
    repo_path,
    objective=None,
    status=None,
    last_step=None,
    next_action=None,
    blockers=None,
    decisions=None,
    files_changed=None,
    test_results=None,
    footprint=None,
    goal=None,
    recent_files=None,
    file_path=None
):
    """
    Update session memory for repo_path with concurrency hardening.
    Appends decisions, updates next_action/last_step/objective without corrupting or wiping history.
    """
    repo_path = os.path.realpath(os.path.abspath(repo_path))
    path = file_path or get_session_file_path()
    lock_path = f"{path}.lock"

    with session_file_lock(lock_path):
        sessions = load_sessions(file_path=file_path)
        existing = sessions["projects"].get(repo_path, {})

        project_name = existing.get("project_name") or os.path.basename(repo_path)
        branch = existing.get("branch", "HEAD")
        if is_git_repo(repo_path):
            try:
                b = subprocess.check_output(
                    ["git", "-C", repo_path, "branch", "--show-current"],
                    stderr=subprocess.DEVNULL,
                    timeout=5
                ).decode("utf-8", "ignore").strip()
                if b:
                    branch = b
            except Exception:
                pass

        # Determine objective and goal
        if objective is not None:
            active_objective = str(objective).strip()
        elif goal is not None:
            active_objective = str(goal).strip()
        else:
            active_objective = existing.get("objective") or existing.get("goal") or ""
        active_goal = active_objective

        # Determine status: in_progress, blocked, completed
        if status is not None:
            s = str(status).strip().lower()
            if s in ("in_progress", "blocked", "completed"):
                active_status = s
            else:
                active_status = "in_progress"
        else:
            active_status = existing.get("status", "in_progress")

        # Determine last_step
        if last_step is not None:
            active_last_step = str(last_step).strip()
        else:
            active_last_step = existing.get("last_step", "")

        # Determine next_action
        if next_action is not None:
            active_next_action = str(next_action).strip()
        else:
            active_next_action = existing.get("next_action", "")

        # Determine blockers (list of strings)
        existing_blockers = list(existing.get("blockers", []))
        if blockers is not None:
            if isinstance(blockers, list):
                active_blockers = [str(b).strip() for b in blockers if str(b).strip()]
            elif isinstance(blockers, str):
                b_str = blockers.strip()
                if b_str and b_str not in existing_blockers:
                    active_blockers = existing_blockers + [b_str]
                else:
                    active_blockers = existing_blockers
            else:
                active_blockers = existing_blockers
        else:
            active_blockers = existing_blockers

        # Append decisions: list of { "timestamp": ..., "decision": ..., "rationale": ..., "rejected_alternatives": ... }
        existing_decisions = list(existing.get("decisions", []))
        if decisions is not None:
            def _normalize_decision(d):
                now_ts = time.time()
                if isinstance(d, dict):
                    rej = d.get("rejected_alternatives", [])
                    if isinstance(rej, str):
                        rej_list = [rej.strip()] if rej.strip() else []
                    elif isinstance(rej, list):
                        rej_list = [str(x).strip() for x in rej if str(x).strip()]
                    else:
                        rej_list = []
                    return {
                        "timestamp": float(d.get("timestamp", now_ts)),
                        "decision": str(d.get("decision", "")),
                        "rationale": str(d.get("rationale", "")),
                        "rejected_alternatives": rej_list,
                    }
                elif isinstance(d, str):
                    return {
                        "timestamp": now_ts,
                        "decision": d.strip(),
                        "rationale": "",
                        "rejected_alternatives": []
                    }
                return None

            if isinstance(decisions, list):
                for item in decisions:
                    norm = _normalize_decision(item)
                    if norm and norm["decision"]:
                        existing_decisions.append(norm)
            else:
                norm = _normalize_decision(decisions)
                if norm and norm["decision"]:
                    existing_decisions.append(norm)

        # Merge files_changed: dict mapping file_path -> { "why": ..., "lines_added": ..., "lines_deleted": ... }
        existing_files_changed = dict(existing.get("files_changed", {}))
        if files_changed is not None and isinstance(files_changed, dict):
            for fpath, finfo in files_changed.items():
                if fpath in existing_files_changed and isinstance(finfo, dict) and isinstance(existing_files_changed[fpath], dict):
                    merged_f = dict(existing_files_changed[fpath])
                    merged_f.update(finfo)
                    existing_files_changed[fpath] = merged_f
                else:
                    existing_files_changed[fpath] = finfo

        # Update test_results: dict { "last_run": ..., "command": ..., "passed": bool, "summary": ... }
        if test_results is not None and isinstance(test_results, dict):
            existing_tests = dict(existing.get("test_results") or {})
            existing_tests.update(test_results)
            active_test_results = existing_tests
        else:
            active_test_results = existing.get("test_results", None)

        # Calculate or update footprint and recent_files
        if footprint is not None:
            active_footprint = footprint
            active_recent = recent_files if recent_files is not None else existing.get("recent_files", [])
        else:
            calc_fp, calc_recent = calculate_footprint(repo_path)
            active_footprint = calc_fp
            active_recent = recent_files if recent_files is not None else (calc_recent if calc_recent else existing.get("recent_files", []))

        now = time.time()
        session_entry = {
            "project_name": project_name,
            "project_path": repo_path,
            "branch": branch,
            "last_active_timestamp": now,
            "objective": active_objective,
            "goal": active_goal,
            "status": active_status,
            "last_step": active_last_step,
            "next_action": active_next_action,
            "blockers": active_blockers,
            "decisions": existing_decisions,
            "files_changed": existing_files_changed,
            "test_results": active_test_results,
            "footprint": active_footprint,
            "recent_files": active_recent,
        }

        # Project history
        proj_history = list(existing.get("history", []))
        proj_history.append({
            "timestamp": now,
            "branch": branch,
            "objective": active_objective,
            "goal": active_goal,
            "status": active_status,
            "last_step": active_last_step,
            "next_action": active_next_action,
            "footprint": active_footprint,
        })
        if len(proj_history) > 20:
            proj_history = proj_history[-20:]
        session_entry["history"] = proj_history

        sessions["projects"][repo_path] = session_entry
        sessions["last_project"] = repo_path

        # Global history
        sessions.setdefault("history", [])
        sessions["history"].append({
            "project_name": project_name,
            "project_path": repo_path,
            "branch": branch,
            "timestamp": now,
            "objective": active_objective,
            "goal": active_goal,
            "status": active_status,
            "last_step": active_last_step,
            "next_action": active_next_action,
            "footprint": active_footprint,
        })
        if len(sessions["history"]) > 50:
            sessions["history"] = sessions["history"][-50:]

        save_sessions(sessions, file_path=file_path)
        return session_entry


def record_session(repo_path, goal=None, file_path=None):
    """
    Record or update session history for repo_path and globally.
    Updates project_name, project_path, branch, last_active_timestamp, goal, footprint, recent_files.
    """
    return update_session(repo_path, objective=goal, goal=goal, file_path=file_path)


def set_active_goal(repo_path, goal_text, file_path=None, next_action=None, blockers=None, last_step=None, status=None):
    """Record or update active goal for the project at repo_path."""
    return update_session(
        repo_path,
        objective=goal_text,
        goal=goal_text,
        next_action=next_action,
        blockers=blockers,
        last_step=last_step,
        status=status,
        file_path=file_path
    )


def get_last_session(repo_path=None, file_path=None):
    """
    Retrieve last session details.
    If repo_path is provided and exists in store, returns that project's session.
    Otherwise returns globally last active session, or None.
    """
    sessions = load_sessions(file_path=file_path)
    projects = sessions.get("projects", {})
    if not projects:
        return None

    if repo_path:
        repo_path = os.path.realpath(os.path.abspath(repo_path))
        if repo_path in projects:
            return projects[repo_path]
        return None

    last_proj = sessions.get("last_project")
    if last_proj and last_proj in projects:
        return projects[last_proj]

    sorted_sessions = sorted(
        projects.values(),
        key=lambda x: x.get("last_active_timestamp", 0),
        reverse=True
    )
    return sorted_sessions[0] if sorted_sessions else None


def find_project_session(project_query, file_path=None):
    """Find session entry matching project_query by name or path."""
    if not project_query:
        return None
    sessions = load_sessions(file_path=file_path)
    projects = sessions.get("projects", {})
    query = str(project_query).strip().lower()

    # Exact path match
    for path, data in projects.items():
        if path.lower() == query:
            return data

    # Normalized path match
    try:
        exp = os.path.realpath(os.path.abspath(os.path.expanduser(str(project_query).strip()))).lower()
        for path, data in projects.items():
            if os.path.realpath(os.path.abspath(path)).lower() == exp:
                return data
    except Exception:
        pass

    # Project name exact match
    for path, data in projects.items():
        pname = data.get("project_name", os.path.basename(path)).lower()
        if pname == query:
            return data

    # Partial match
    for path, data in projects.items():
        pname = data.get("project_name", os.path.basename(path)).lower()
        if query in pname or query in path.lower():
            return data

    return None


def get_resume_context(project=None, cwd=None, file_path=None):
    """
    Generate compact, highly accurate context handoff data.
    Returns dictionary with handoff information.
    """
    if project:
        session = find_project_session(project, file_path=file_path)
        if not session:
            # Check if project is a direct directory path
            exp = os.path.abspath(os.path.expanduser(project))
            if os.path.isdir(exp):
                session = get_last_session(exp, file_path=file_path)
                if not session:
                    session = record_session(exp, file_path=file_path)
    else:
        check_cwd = cwd or os.getcwd()
        repo_root = find_repo_root(check_cwd)
        if repo_root:
            session = get_last_session(repo_root, file_path=file_path)
            if not session:
                session = record_session(repo_root, file_path=file_path)
        else:
            session = get_last_session(None, file_path=file_path)

    if not session:
        return None

    project_name = session.get("project_name") or os.path.basename(session.get("project_path", "unknown"))
    project_path = session.get("project_path", "")
    branch = session.get("branch") or "HEAD"
    objective = session.get("objective") or session.get("goal") or "None set"
    status = session.get("status", "in_progress")
    last_step = session.get("last_step") or "None recorded"
    next_action = session.get("next_action") or 'None specified. Run: dc goal --next "<action>"'
    blockers = session.get("blockers") or []
    files_changed = session.get("files_changed") or {}
    recent_files = session.get("recent_files") or []
    footprint = session.get("footprint") or "clean"
    decisions = session.get("decisions") or []
    test_results = session.get("test_results")

    # Generate markdown
    md_lines = [
        f"# Session Handoff: {project_name} ({branch})",
        f"**Repository**: `{project_path}`\n",
        "## Objective & Status",
        f"- **Goal**: {objective}",
        f"- **Status**: `{status}`\n",
        "## What Changed",
        f"- **Footprint**: {footprint}",
    ]

    if files_changed:
        md_lines.append("- **Files Changed**:")
        for fpath, finfo in files_changed.items():
            if isinstance(finfo, dict):
                why = finfo.get("why", "")
                ins = finfo.get("lines_added", 0)
                dels = finfo.get("lines_deleted", 0)
                stat_str = f" (+{ins}/-{dels})" if (ins or dels) else ""
                why_str = f": {why}" if why else ""
                md_lines.append(f"  • `{fpath}`{stat_str}{why_str}")
            else:
                md_lines.append(f"  • `{fpath}`: {finfo}")
    elif recent_files:
        md_lines.append(f"- **Touched Files**: {', '.join(recent_files[:6])}")

    md_lines.extend([
        "",
        "## Last Completed Step",
        last_step,
        "",
        "## Blockers & Unfinished Work",
    ])

    if blockers:
        for b in blockers:
            md_lines.append(f"- {b}")
    else:
        md_lines.append("- None recorded")

    md_lines.extend([
        "",
        "## Exact Next Concrete Action",
        f"> {next_action}",
    ])

    if decisions:
        md_lines.extend(["", "## Recent Decisions"])
        for d in decisions[-3:]:
            md_lines.append(f"- **{d.get('decision')}**: {d.get('rationale') or 'no rationale'}")

    if test_results:
        md_lines.extend([
            "",
            "## Last Test Run",
            f"- Command: `{test_results.get('command')}`",
            f"- Passed: {test_results.get('passed')}",
            f"- Summary: {test_results.get('summary')}",
        ])

    markdown = "\n".join(md_lines) + "\n"

    return {
        "project": project_name,
        "path": project_path,
        "branch": branch,
        "objective": objective,
        "status": status,
        "last_step": last_step,
        "next_action": next_action,
        "blockers": blockers,
        "footprint": footprint,
        "files_changed": files_changed,
        "recent_files": recent_files,
        "decisions": decisions,
        "test_results": test_results,
        "markdown": markdown,
    }


def cmd_resume(project=None, as_json=False, file_path=None):
    """CLI handler for dc resume [-p project] [--json]."""
    ctx = get_resume_context(project=project, file_path=file_path)
    if not ctx:
        if project:
            print(f"{RED}Error: Project '{project}' not found in recorded sessions.{RESET}")
        else:
            print(f"{CYAN}No recorded sessions found.{RESET}")
            print(f"{DIM}Run 'dc goal \"<objective>\"' inside a repository first.{RESET}")
        return

    if as_json:
        data = {k: v for k, v in ctx.items() if k != "markdown"}
        print(json.dumps(data, indent=2))
    else:
        print(ctx["markdown"])


def resolve_repo_path(repo_query, projects_dir=None, session_file=None, cwd=None):
    """Resolve repository name or path to absolute filesystem directory."""
    if not repo_query:
        return None

    # 1. Direct path check
    expanded = os.path.abspath(os.path.expanduser(repo_query))
    if os.path.isdir(expanded):
        return expanded

    # 2. Check cwd
    if cwd:
        cwd_abs = os.path.abspath(cwd)
        if os.path.basename(cwd_abs).lower() == repo_query.lower() and os.path.isdir(cwd_abs):
            return cwd_abs
        root = find_repo_root(cwd_abs)
        if root and os.path.basename(root).lower() == repo_query.lower() and os.path.isdir(root):
            return root

    # 3. Check session store
    sessions = load_sessions(file_path=session_file)
    for ppath, pdata in sessions.get("projects", {}).items():
        if os.path.basename(ppath).lower() == repo_query.lower() or pdata.get("project_name", "").lower() == repo_query.lower():
            if os.path.isdir(ppath):
                return ppath

    # 4. Check workspace directories
    projects_base = projects_dir or os.getenv("DEV_CONTEXT_DIR", os.path.expanduser("~/Projects"))
    if os.path.isdir(projects_base):
        try:
            for entry in os.scandir(projects_base):
                if entry.is_dir():
                    if entry.name.lower() == repo_query.lower():
                        return entry.path
                    # Check 1 level deeper
                    try:
                        for sub in os.scandir(entry.path):
                            if sub.is_dir() and sub.name.lower() == repo_query.lower():
                                return sub.path
                    except OSError:
                        pass
        except OSError:
            pass

    return None


def get_repo_inspection(repo_query, projects_dir=None, session_file=None):
    """Gather inspection data for a workspace repository without changing directory."""
    repo_path = resolve_repo_path(repo_query, projects_dir=projects_dir, session_file=session_file)
    if not repo_path or not os.path.isdir(repo_path):
        return None

    project_name = os.path.basename(repo_path)
    git_info = get_git_info(repo_path) if is_git_repo(repo_path) else None
    footprint, recent_files = calculate_footprint(repo_path)
    session = get_last_session(repo_path, file_path=session_file)

    # Check for roadmap tasks
    roadmap_file = find_roadmap_file(cwd=repo_path)
    tasks = []
    if roadmap_file:
        open_tasks, _ = get_open_tasks(roadmap_file)
        for t in open_tasks:
            if not t.get("project") or t.get("project").lower() == project_name.lower():
                tasks.append({
                    "id": t["id"],
                    "state": t["state"],
                    "state_label": t["state_label"],
                    "text": t["display_text"],
                })

    branch = git_info["branch"] if git_info else (session.get("branch") if session else "HEAD")
    dirty_count = git_info["dirty_count"] if git_info else 0
    dirty_lines = git_info["dirty_lines"] if git_info else []
    last_commit = {
        "rel_time": git_info["rel_time"] if git_info else "",
        "subject": git_info["subject"] if git_info else "",
    } if git_info else None

    return {
        "project_name": project_name,
        "project_path": repo_path,
        "is_git": git_info is not None,
        "branch": branch,
        "status": "dirty" if dirty_count > 0 else "clean",
        "dirty_count": dirty_count,
        "dirty_lines": dirty_lines,
        "last_commit": last_commit,
        "footprint": footprint,
        "recent_files": recent_files,
        "session": session or {},
        "tasks": tasks,
    }


def cmd_inspect(repo_query, as_json=False, projects_dir=None, session_file=None):
    """CLI handler for dc inspect <repo>."""
    data = get_repo_inspection(repo_query, projects_dir=projects_dir, session_file=session_file)
    if not data:
        print(f"{RED}Error: Repository '{repo_query}' not found in workspace.{RESET}")
        return

    if as_json:
        print(json.dumps(data, indent=2))
        return

    session = data["session"]
    status_badge = f"{YELLOW}[DIRTY: {data['dirty_count']} files]{RESET}" if data["dirty_count"] else f"{GREEN}[CLEAN]{RESET}"

    print(f"\n🔍 {BOLD}INSPECT:{RESET} {CYAN}{data['project_name']}{RESET} ({data['branch']}) {status_badge}")
    print(f"   {BOLD}Path:{RESET}        {data['project_path']}")
    print(f"   {BOLD}Changes:{RESET}     {data['footprint']}")
    if data["last_commit"] and data["last_commit"]["subject"]:
        print(f"   {BOLD}Last Commit:{RESET} {data['last_commit']['rel_time']} — {DIM}{data['last_commit']['subject']}{RESET}")

    print(f"\n{BOLD}SESSION MEMORY{RESET}")
    goal = session.get("objective") or session.get("goal") or "None set"
    print(f"  {BOLD}Objective:{RESET}   {goal}")
    print(f"  {BOLD}Status:{RESET}      {session.get('status', 'in_progress')}")
    if session.get("last_step"):
        print(f"  {BOLD}Last Step:{RESET}   {session['last_step']}")
    if session.get("next_action"):
        print(f"  {BOLD}Next Action:{RESET} {session['next_action']}")
    if session.get("blockers"):
        print(f"  {BOLD}Blockers:{RESET}    {', '.join(session['blockers'])}")

    if data["tasks"]:
        print(f"\n{BOLD}TASKS ({len(data['tasks'])}){RESET}")
        for t in data["tasks"][:5]:
            badge = format_state_badge(t["state"])
            print(f"  [{t['id']}] {badge} {t['text']}")
    print()


def cmd_goal(text=None, next_action=None, blockers=None, last_step=None, status=None, file_path=None):
    """CLI handler for dc goal."""
    cwd = os.getcwd()
    repo_root = find_repo_root(cwd) or os.path.abspath(cwd)

    # If called with no updates at all
    if text is None and next_action is None and blockers is None and last_step is None and status is None:
        session = get_last_session(repo_root, file_path=file_path)
        if session and (session.get("objective") or session.get("goal")):
            obj = session.get("objective") or session.get("goal")
            print(f"🎯 {BOLD}Active goal for {session['project_name']}:{RESET} {obj}")
            if session.get("status"):
                print(f"   {BOLD}Status:{RESET}      {session['status']}")
            if session.get("last_step"):
                print(f"   {BOLD}Last step:{RESET}   {session['last_step']}")
            if session.get("next_action"):
                print(f"   {BOLD}Next action:{RESET} {session['next_action']}")
            if session.get("blockers"):
                print(f"   {BOLD}Blockers:{RESET}    {', '.join(session['blockers'])}")
        else:
            prog = os.path.basename(sys.argv[0])
            print(f"{CYAN}No active goal set for {os.path.basename(repo_root)}.{RESET}")
            print(f"{DIM}Set one with: {prog} goal \"<objective>\"{RESET}")
        return

    session = update_session(
        repo_root,
        objective=text,
        goal=text,
        status=status,
        last_step=last_step,
        next_action=next_action,
        blockers=blockers,
        file_path=file_path
    )
    obj = session.get("objective") or text or "(no objective set)"
    print(f"{GREEN}✓ Active goal set for {session['project_name']}:{RESET} {obj}")
    if session.get("last_step"):
        print(f"   {BOLD}Last Step:{RESET} {session['last_step']}")
    if session.get("next_action"):
        print(f"   {BOLD}Next Action:{RESET} {session['next_action']}")
    if session.get("blockers"):
        print(f"   {BOLD}Blockers:{RESET} {', '.join(session['blockers'])}")


def cmd_session(file_path=None):
    """CLI handler for dc session."""
    cwd = os.getcwd()
    repo_root = find_repo_root(cwd)
    session = get_last_session(repo_root, file_path=file_path) if repo_root else None
    if not session:
        session = get_last_session(None, file_path=file_path)

    if not session:
        print(f"{CYAN}No recorded sessions found.{RESET}")
        print(f"{DIM}Run 'dc goal \"<text>\"' or 'dev-context' inside a git repository.{RESET}")
        return

    project = session.get("project_name") or os.path.basename(session.get("project_path", "unknown"))
    branch = session.get("branch") or "HEAD"
    rel_time = format_rel_time(session.get("last_active_timestamp"))
    goal = session.get("objective") or session.get("goal") or 'No goal set. Run: dc goal "..."'
    footprint = session.get("footprint") or "clean"
    recent_files = session.get("recent_files", [])

    print(f"\n🧠 {BOLD}Session Details:{RESET}")
    print(f"   {BOLD}Project:{RESET}   {CYAN}{project}{RESET} ({branch})")
    print(f"   {BOLD}Path:{RESET}      {session.get('project_path', '')}")
    print(f"   {BOLD}Elapsed:{RESET}   {rel_time}")
    print(f"   {BOLD}Goal:{RESET}      {goal}")
    if session.get("status"):
        print(f"   {BOLD}Status:{RESET}    {session.get('status')}")
    if session.get("last_step"):
        print(f"   {BOLD}Last Step:{RESET} {session.get('last_step')}")
    if session.get("next_action"):
        print(f"   {BOLD}Next:{RESET}      {session.get('next_action')}")
    if session.get("blockers"):
        print(f"   {BOLD}Blockers:{RESET}  {', '.join(session.get('blockers'))}")
    print(f"   {BOLD}Footprint:{RESET} {footprint}")
    if recent_files:
        print(f"   {BOLD}Recent Files:{RESET}")
        for rf in recent_files[:5]:
            print(f"     • {rf}")
        if len(recent_files) > 5:
            print(f"     {DIM}... and {len(recent_files) - 5} more files{RESET}")
    print()


# ---------------------------------------------------------------------------
# Native Agent Injection & MCP Server Engine
# ---------------------------------------------------------------------------

def get_active_context_data(cwd=None, local_only=False, projects_dir=None, session_file=None, roadmap_file=None):
    """
    Gather complete active context dictionary:
    - active_project (name, path, in_git, branch, status, dirty_count, dirty_files, last_commit)
    - session_goal
    - footprint (summary, files)
    - priority_tasks (list of open tasks with id, state, state_label, text, project)
    - roadmap_file (path to resolved roadmap)
    - workspace_alerts (list of other dirty repositories across projects_dir)
    """
    if cwd is None:
        cwd = os.getcwd()
    cwd = os.path.abspath(cwd)

    repo_root = find_repo_root(cwd)
    in_git = repo_root is not None

    if in_git:
        project_name = os.path.basename(repo_root)
        project_path = repo_root
        git_info = get_git_info(repo_root)
        branch = git_info["branch"] if git_info else "HEAD"
        dirty_count = git_info["dirty_count"] if git_info else 0
        dirty_files = git_info["dirty_lines"] if git_info else []
        status = "dirty" if dirty_count > 0 else "clean"
        last_commit = {
            "relative_time": git_info["rel_time"] if git_info else "",
            "subject": git_info["subject"] if git_info else ""
        } if git_info else None
        footprint_str, recent_files = calculate_footprint(repo_root)
        session = get_last_session(repo_root, file_path=session_file)
        session_goal = session.get("goal", "") if session else ""
    else:
        project_name = None
        project_path = cwd
        branch = None
        dirty_count = 0
        dirty_files = []
        status = "clean"
        last_commit = None
        footprint_str = "clean"
        recent_files = []
        session = get_last_session(None, file_path=session_file)
        session_goal = session.get("goal", "") if session else ""

    resolved_roadmap = roadmap_file or find_roadmap_file(local_only=local_only, cwd=cwd)
    tasks, _ = get_open_tasks(resolved_roadmap) if resolved_roadmap else ([], [])
    priority_tasks = []
    for t in tasks:
        priority_tasks.append({
            "id": t["id"],
            "task_num": t.get("task_num"),
            "state": t["state"],
            "state_label": t["state_label"],
            "text": t["display_text"],
            "project": t.get("project"),
        })

    projects_base = projects_dir or os.getenv("DEV_CONTEXT_DIR", os.path.expanduser("~/Projects"))
    all_repos = scan_repositories(projects_base)
    workspace_alerts = []
    for name, info in all_repos:
        if in_git and os.path.abspath(info.get("path", "")) == os.path.abspath(repo_root):
            continue
        if info.get("dirty_count", 0) > 0:
            workspace_alerts.append({
                "name": name,
                "path": info.get("path", ""),
                "dirty_count": info.get("dirty_count", 0),
                "rel_time": info.get("rel_time", ""),
                "subject": info.get("subject", ""),
                "dirty_lines": info.get("dirty_lines", []),
            })

    return {
        "active_project": {
            "name": project_name,
            "path": project_path,
            "in_git": in_git,
            "branch": branch,
            "status": status,
            "dirty_count": dirty_count,
            "dirty_files": dirty_files,
            "last_commit": last_commit,
        },
        "branch": branch,
        "session_goal": session_goal,
        "footprint": {
            "summary": footprint_str,
            "files": recent_files,
        },
        "recent_files": recent_files,
        "priority_tasks": priority_tasks,
        "roadmap_file": resolved_roadmap,
        "workspace_alerts": workspace_alerts,
        "other_dirty_repos": workspace_alerts,
    }


def format_context_markdown(ctx):
    proj = ctx.get("active_project", {})
    footprint = ctx.get("footprint", {})
    goal = ctx.get("session_goal")
    tasks = ctx.get("priority_tasks", [])
    alerts = ctx.get("workspace_alerts", [])
    roadmap = ctx.get("roadmap_file")

    lines = []
    lines.append("# Developer Context Briefing")
    lines.append("")

    # Active Project
    lines.append("## Active Project")
    if proj.get("in_git"):
        lines.append(f"- **Project**: {proj.get('name')} (`{proj.get('branch')}`)")
        lines.append(f"- **Path**: `{proj.get('path')}`")
        status_text = f"{proj.get('status')} ({proj.get('dirty_count')} uncommitted files)" if proj.get('dirty_count') else "clean"
        lines.append(f"- **Status**: {status_text}")
    else:
        lines.append(f"- **Project**: None (outside Git repository)")
        lines.append(f"- **Path**: `{proj.get('path')}`")
        lines.append(f"- **Status**: clean")

    goal_display = goal if goal else "No active goal set."
    lines.append(f"- **Session Goal**: {goal_display}")

    fp_summary = footprint.get("summary", "clean")
    lines.append(f"- **Footprint**: {fp_summary}")
    fp_files = footprint.get("files", [])
    if fp_files:
        for f in fp_files[:5]:
            lines.append(f"  - `{f}`")
        if len(fp_files) > 5:
            lines.append(f"  - ... and {len(fp_files) - 5} more files")

    lc = proj.get("last_commit")
    if lc and lc.get("subject"):
        lines.append(f"- **Last Commit**: {lc.get('relative_time')} - {lc.get('subject')}")

    lines.append("")

    # Priority Tasks
    scope_name = os.path.basename(roadmap) if roadmap else "Roadmap"
    lines.append(f"## Priority Tasks ({scope_name})")
    if tasks:
        for t in tasks[:10]:
            lines.append(f"- [{t['id']}] {t['state_label']} {t['text']}")
        if len(tasks) > 10:
            lines.append(f"- ... and {len(tasks) - 10} more tasks")
    else:
        lines.append("No pending tasks in roadmap.")

    lines.append("")

    # Workspace In-Progress / Alerts
    lines.append("## Workspace Alerts (Uncommitted Work)")
    if alerts:
        for a in alerts[:6]:
            lines.append(f"- **{a['name']}** ({a['dirty_count']} modified) - {a['rel_time']}: {a['subject']}")
        if len(alerts) > 6:
            lines.append(f"- ... and {len(alerts) - 6} more dirty repositories")
    else:
        lines.append("All other workspace repositories are clean.")

    lines.append("")
    return "\n".join(lines)


def cmd_export(agent=False, as_json=False, local=False, file_path=None, projects_dir=None, cwd=None, roadmap_file=None):
    """CLI handler for dc export."""
    data = get_active_context_data(cwd=cwd, local_only=local, projects_dir=projects_dir, session_file=file_path, roadmap_file=roadmap_file)
    if as_json:
        print(json.dumps(data, indent=2))
    else:
        print(format_context_markdown(data))


def _rpc_error(req_id, code, message):
    """Format standard JSON-RPC 2.0 error response."""
    return {
        "jsonrpc": "2.0",
        "id": req_id,
        "error": {
            "code": code,
            "message": message,
        },
    }


def _rpc_result(req_id, content_data, is_error=False):
    """Format standard JSON-RPC 2.0 result response."""
    text_val = content_data if isinstance(content_data, str) else json.dumps(content_data, indent=2)
    return {
        "jsonrpc": "2.0",
        "id": req_id,
        "result": {
            "content": [
                {
                    "type": "text",
                    "text": text_val,
                }
            ],
            "isError": is_error,
        },
    }


def _extract_project_purpose(project_path, session=None):
    """Extract project purpose from session or README."""
    if session:
        obj = session.get("objective") or session.get("goal")
        if obj and str(obj).strip():
            return str(obj).strip()
    if not project_path or not os.path.isdir(project_path):
        return None
    for name in ("README.md", "README", "readme.md", "Readme.md"):
        readme_file = os.path.join(project_path, name)
        if os.path.isfile(readme_file):
            try:
                with open(readme_file, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        line_s = line.strip()
                        if not line_s:
                            continue
                        if line_s.startswith("#"):
                            parts = line_s.lstrip("#").strip().split(" - ", 1)
                            if len(parts) > 1 and parts[1].strip():
                                return parts[1].strip()[:200]
                            continue
                        clean_line = line_s.lstrip(">").strip().strip("*").strip()
                        if clean_line:
                            return clean_line[:200]
            except Exception:
                pass
    return None


def _get_git_remote_url(repo_path, timeout=5):
    """Retrieve remote origin URL for repository if available."""
    if not repo_path or not is_git_repo(repo_path):
        return None
    try:
        url = subprocess.check_output(
            ["git", "-C", repo_path, "config", "--get", "remote.origin.url"],
            stderr=subprocess.DEVNULL,
            timeout=timeout
        ).decode("utf-8", "ignore").strip()
        return url or None
    except Exception:
        return None


def _get_recent_commits(repo_path, limit=5, timeout=5):
    """Retrieve recent git commits list."""
    if not repo_path or not is_git_repo(repo_path):
        return []
    try:
        out = subprocess.check_output(
            ["git", "-C", repo_path, "log", f"-n{limit}", "--format=%h|%cr|%s"],
            stderr=subprocess.DEVNULL,
            timeout=timeout
        ).decode("utf-8", "ignore").strip()
        commits = []
        if out:
            for line in out.splitlines():
                parts = line.split("|", 2)
                if len(parts) == 3:
                    commits.append({
                        "hash": parts[0],
                        "relative_time": parts[1],
                        "subject": parts[2],
                    })
        return commits
    except Exception:
        return []


def _get_modified_files(repo_path, timeout=5):
    """Retrieve modified / dirty file paths."""
    if not repo_path or not is_git_repo(repo_path):
        return []
    try:
        out = subprocess.check_output(
            ["git", "-C", repo_path, "status", "--porcelain"],
            stderr=subprocess.DEVNULL,
            timeout=timeout
        ).decode("utf-8", "ignore").strip()
        files = []
        if out:
            for line in out.splitlines():
                if len(line) > 3:
                    files.append(line[3:].strip())
        return files
    except Exception:
        return []


def _load_mcp_module():
    """Load dev_context_mcp module from sibling or parent directory."""
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (here, os.path.dirname(here)):
        if os.path.isfile(os.path.join(candidate, "dev_context_mcp.py")):
            if candidate not in sys.path:
                sys.path.insert(0, candidate)
            break
    import dev_context_mcp
    return dev_context_mcp


def handle_mcp_tool_call(req_id, tool_name, tool_args, session_file=None, roadmap_file=None, cwd=None):
    """Dispatch and execute an MCP tool invocation."""
    if not isinstance(tool_args, dict):
        return _rpc_error(req_id, -32602, "Invalid params: 'arguments' must be an object")

    # 1. get_project_context
    if tool_name == "get_project_context":
        project_param = tool_args.get("project")
        if project_param is not None and not isinstance(project_param, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'project' must be a string")

        target_cwd = cwd or os.getcwd()
        if project_param:
            repo_path = resolve_repo_path(project_param, session_file=session_file, cwd=target_cwd)
            if not repo_path:
                sess = find_project_session(project_param, file_path=session_file)
                if sess and sess.get("project_path") and os.path.isdir(sess["project_path"]):
                    repo_path = sess["project_path"]
            if not repo_path:
                return _rpc_error(req_id, -32602, f"Project '{project_param}' not found")
        else:
            repo_path = find_repo_root(target_cwd) or os.path.abspath(target_cwd)

        sess = get_last_session(repo_path, file_path=session_file)
        git_info = get_git_info(repo_path) if is_git_repo(repo_path) else None

        project_name = (sess.get("project_name") if sess else None) or os.path.basename(repo_path)
        branch = git_info["branch"] if git_info else (sess.get("branch") if sess else "HEAD")
        remote_url = _get_git_remote_url(repo_path)
        purpose = _extract_project_purpose(repo_path, session=sess)
        last_commit = {
            "relative_time": git_info["rel_time"],
            "subject": git_info["subject"],
        } if git_info and git_info.get("subject") else None
        dirty_count = git_info["dirty_count"] if git_info else 0

        data = {
            "name": project_name,
            "branch": branch,
            "path": os.path.abspath(repo_path),
            "remote_url": remote_url,
            "purpose": purpose,
            "last_commit": last_commit,
            "dirty_count": dirty_count,
        }
        return _rpc_result(req_id, data)

    # 2. get_current_goal
    elif tool_name == "get_current_goal":
        project_param = tool_args.get("project")
        if project_param is not None and not isinstance(project_param, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'project' must be a string")

        target_cwd = cwd or os.getcwd()
        if project_param:
            sess = find_project_session(project_param, file_path=session_file)
            repo_path = resolve_repo_path(project_param, session_file=session_file, cwd=target_cwd)
            if not sess and repo_path:
                sess = get_last_session(repo_path, file_path=session_file)
            if not sess:
                if repo_path:
                    pname = os.path.basename(repo_path)
                    sess = {}
                else:
                    return _rpc_error(req_id, -32602, f"Project '{project_param}' not found in recorded sessions")
            else:
                pname = sess.get("project_name") or (os.path.basename(repo_path) if repo_path else project_param)
        else:
            repo_root = find_repo_root(target_cwd) or target_cwd
            sess = get_last_session(repo_root, file_path=session_file)
            pname = (sess.get("project_name") if sess else None) or os.path.basename(repo_root)
            if not sess:
                sess = {}

        data = {
            "project": pname,
            "objective": sess.get("objective") or sess.get("goal") or "",
            "status": sess.get("status", "in_progress"),
            "last_step": sess.get("last_step", ""),
            "next_action": sess.get("next_action", ""),
            "blockers": sess.get("blockers") or [],
        }
        return _rpc_result(req_id, data)

    # 3. update_session
    elif tool_name == "update_session":
        project_param = tool_args.get("project")
        if project_param is not None and not isinstance(project_param, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'project' must be a string")

        objective = tool_args.get("objective")
        if objective is not None and not isinstance(objective, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'objective' must be a string")

        status = tool_args.get("status")
        if status is not None:
            if not isinstance(status, str) or status.strip().lower() not in ("in_progress", "blocked", "completed"):
                return _rpc_error(req_id, -32602, f"Invalid status: '{status}'. Allowed: in_progress, blocked, completed")
            status = status.strip().lower()

        last_step = tool_args.get("last_step")
        if last_step is not None and not isinstance(last_step, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'last_step' must be a string")

        next_action = tool_args.get("next_action")
        if next_action is not None and not isinstance(next_action, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'next_action' must be a string")

        blocker = tool_args.get("blocker")
        if blocker is not None and not isinstance(blocker, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'blocker' must be a string")

        decision = tool_args.get("decision")
        if decision is not None:
            if not isinstance(decision, dict) or "decision" not in decision or not isinstance(decision["decision"], str):
                return _rpc_error(req_id, -32602, "Invalid decision: expected object with 'decision' string property")

        file_changed = tool_args.get("file_changed")
        if file_changed is not None:
            if not isinstance(file_changed, dict) or "path" not in file_changed or not isinstance(file_changed["path"], str):
                return _rpc_error(req_id, -32602, "Invalid file_changed: expected object with 'path' string property")

        target_cwd = cwd or os.getcwd()
        if project_param:
            repo_path = resolve_repo_path(project_param, session_file=session_file, cwd=target_cwd)
            if not repo_path:
                sess = find_project_session(project_param, file_path=session_file)
                if sess and sess.get("project_path"):
                    repo_path = sess["project_path"]
            if not repo_path:
                exp = os.path.abspath(os.path.expanduser(project_param))
                if os.path.isdir(exp):
                    repo_path = exp
            if not repo_path:
                return _rpc_error(req_id, -32602, f"Project '{project_param}' not found")
        else:
            repo_path = find_repo_root(target_cwd) or os.path.abspath(target_cwd)

        blockers_arg = blocker if blocker else None
        decisions_arg = [decision] if decision else None
        files_dict = None
        if file_changed:
            files_dict = {
                file_changed["path"]: {
                    "why": file_changed.get("why", "")
                }
            }

        updated = update_session(
            repo_path,
            objective=objective,
            status=status,
            last_step=last_step,
            next_action=next_action,
            blockers=blockers_arg,
            decisions=decisions_arg,
            files_changed=files_dict,
            file_path=session_file,
        )

        resp_data = {
            "success": True,
            "message": f"Session updated successfully for {updated.get('project_name', os.path.basename(repo_path))}",
            "session": {
                "project": updated.get("project_name", os.path.basename(repo_path)),
                "path": updated.get("project_path", repo_path),
                "branch": updated.get("branch", "HEAD"),
                "objective": updated.get("objective") or updated.get("goal") or "",
                "status": updated.get("status", "in_progress"),
                "last_step": updated.get("last_step", ""),
                "next_action": updated.get("next_action", ""),
                "blockers": updated.get("blockers", []),
                "decisions": updated.get("decisions", []),
                "files_changed": updated.get("files_changed", {}),
            },
        }
        return _rpc_result(req_id, resp_data)

    # 4. get_open_tasks
    elif tool_name == "get_open_tasks":
        project_param = tool_args.get("project")
        if project_param is not None and not isinstance(project_param, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'project' must be a string")
        include_blocked = tool_args.get("include_blocked", True)
        if not isinstance(include_blocked, bool):
            return _rpc_error(req_id, -32602, "Invalid params: 'include_blocked' must be a boolean")

        target_roadmap = roadmap_file or find_roadmap_file(cwd=cwd)
        tasks, _ = get_open_tasks(target_roadmap) if target_roadmap else ([], [])
        if not include_blocked:
            tasks = [t for t in tasks if t["state"] != "blocked"]
        if project_param:
            proj_lower = str(project_param).strip().lower()
            tasks = [
                t for t in tasks
                if (t.get("project") and t["project"].lower() == proj_lower)
                or f"({proj_lower})" in t["text"].lower()
                or f"[{proj_lower}]" in t["text"].lower()
                or t["text"].lower().startswith(f"{proj_lower}:")
                or f"#{proj_lower}" in t["text"].lower()
            ]

        formatted = [
            {
                "id": t["id"],
                "task_num": t.get("task_num"),
                "state": t["state"],
                "state_label": t["state_label"],
                "text": t["display_text"],
                "project": t.get("project"),
            }
            for t in tasks
        ]
        return _rpc_result(req_id, formatted)

    # 5. get_recent_changes
    elif tool_name == "get_recent_changes":
        project_param = tool_args.get("project")
        if project_param is not None and not isinstance(project_param, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'project' must be a string")
        limit_commits = tool_args.get("limit_commits", 5)
        if not isinstance(limit_commits, int) or isinstance(limit_commits, bool) or limit_commits < 1:
            return _rpc_error(req_id, -32602, "Invalid params: 'limit_commits' must be a positive integer")

        target_cwd = cwd or os.getcwd()
        if project_param:
            repo_path = resolve_repo_path(project_param, session_file=session_file, cwd=target_cwd)
            if not repo_path:
                sess = find_project_session(project_param, file_path=session_file)
                if sess and sess.get("project_path"):
                    repo_path = sess["project_path"]
            if not repo_path:
                return _rpc_error(req_id, -32602, f"Project '{project_param}' not found")
        else:
            repo_path = find_repo_root(target_cwd) or os.path.abspath(target_cwd)

        footprint_str, recent_files = calculate_footprint(repo_path)
        modified_files = _get_modified_files(repo_path)
        commits = _get_recent_commits(repo_path, limit=limit_commits)
        pname = os.path.basename(repo_path)

        data = {
            "project": pname,
            "path": os.path.abspath(repo_path),
            "footprint": footprint_str,
            "modified_files": modified_files,
            "recent_commits": commits,
        }
        return _rpc_result(req_id, data)

    # 6. mark_task_status
    elif tool_name == "mark_task_status":
        if "id" not in tool_args or not isinstance(tool_args["id"], str) or not tool_args["id"].strip():
            return _rpc_error(req_id, -32602, "Missing or invalid parameter 'id'")
        if "status" not in tool_args or not isinstance(tool_args["status"], str):
            return _rpc_error(req_id, -32602, "Missing or invalid parameter 'status'")

        status = tool_args["status"].strip().lower()
        if status not in ("start", "done", "block", "rm"):
            return _rpc_error(req_id, -32602, f"Invalid status: '{status}'. Allowed: start, done, block, rm")

        reason = tool_args.get("reason")
        if reason is not None and not isinstance(reason, str):
            return _rpc_error(req_id, -32602, "Invalid parameter 'reason': expected string")

        task_id = tool_args["id"].strip()
        target_roadmap = roadmap_file or find_roadmap_file(cwd=cwd)
        if not target_roadmap:
            return _rpc_result(req_id, "Error: Roadmap file not found.", is_error=True)

        action_map = {
            "start": ("in_progress", False),
            "done": ("completed", False),
            "block": ("blocked", False),
            "rm": (None, True),
        }
        new_state, remove = action_map[status]
        success = _change_task_state(task_id=task_id, new_state=new_state, remove=remove, file_path=target_roadmap, quiet=True)
        if success:
            if status == "block" and reason:
                target_cwd = cwd or os.getcwd()
                repo_root = find_repo_root(target_cwd) or target_cwd
                try:
                    update_session(repo_root, blocker=f"[{task_id}] {reason}", file_path=session_file)
                except Exception:
                    pass
            resp_data = {
                "success": True,
                "id": task_id,
                "status": status,
                "message": f"Task [{task_id}] successfully marked as '{status}'.",
            }
            return _rpc_result(req_id, resp_data)
        else:
            return _rpc_result(req_id, f"Error: Task [{task_id}] not found or could not be modified.", is_error=True)

    # 7. get_next_action
    elif tool_name == "get_next_action":
        project_param = tool_args.get("project")
        if project_param is not None and not isinstance(project_param, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'project' must be a string")

        target_cwd = cwd or os.getcwd()
        sess = None
        repo_path = None
        if project_param:
            sess = find_project_session(project_param, file_path=session_file)
            repo_path = resolve_repo_path(project_param, session_file=session_file, cwd=target_cwd)
            if not sess and repo_path:
                sess = get_last_session(repo_path, file_path=session_file)
            if not sess and not repo_path:
                return _rpc_error(req_id, -32602, f"Project '{project_param}' not found")
            pname = (sess.get("project_name") if sess else None) or (os.path.basename(repo_path) if repo_path else project_param)
        else:
            repo_path = find_repo_root(target_cwd) or target_cwd
            sess = get_last_session(repo_path, file_path=session_file)
            pname = (sess.get("project_name") if sess else None) or os.path.basename(repo_path)

        candidate_action = sess.get("next_action") if sess else None
        if candidate_action and candidate_action.strip() and "None specified" not in candidate_action:
            action_text = candidate_action.strip()
            source = "session"
        else:
            target_roadmap = roadmap_file or find_roadmap_file(cwd=repo_path if repo_path else target_cwd)
            tasks, _ = get_open_tasks(target_roadmap) if target_roadmap else ([], [])
            if project_param or (sess and sess.get("project_name")):
                p_filter = (project_param or sess.get("project_name")).lower()
                matched = [t for t in tasks if (t.get("project") and t["project"].lower() == p_filter) or f"({p_filter})" in t["text"].lower()]
                if matched:
                    tasks = matched
            in_prog = [t for t in tasks if t["state"] == "in_progress"]
            todo = [t for t in tasks if t["state"] == "todo"]
            top_task = in_prog[0] if in_prog else (todo[0] if todo else None)
            if top_task:
                action_text = f"[{top_task['id']}] {top_task['display_text']}"
                source = "roadmap"
            else:
                action_text = "No next action or pending tasks recorded."
                source = "none"

        data = {
            "project": pname,
            "next_action": action_text,
            "source": source,
        }
        return _rpc_result(req_id, data)

    # 8. get_resume_handoff
    elif tool_name == "get_resume_handoff":
        project_param = tool_args.get("project")
        if project_param is not None and not isinstance(project_param, str):
            return _rpc_error(req_id, -32602, "Invalid params: 'project' must be a string")
        fmt = tool_args.get("format", "markdown")
        if not isinstance(fmt, str) or fmt.strip().lower() not in ("markdown", "json"):
            return _rpc_error(req_id, -32602, f"Invalid format: '{fmt}'. Allowed: markdown, json")
        fmt = fmt.strip().lower()

        ctx = get_resume_context(project=project_param, cwd=cwd, file_path=session_file)
        if not ctx:
            if project_param:
                return _rpc_error(req_id, -32602, f"Project '{project_param}' not found in recorded sessions")
            else:
                return _rpc_result(req_id, "No recorded sessions found. Run 'dc goal <objective>' inside a repository first.", is_error=True)

        if fmt == "markdown":
            return _rpc_result(req_id, ctx["markdown"])
        else:
            data = {k: v for k, v in ctx.items() if k != "markdown"}
            return _rpc_result(req_id, data)

    # Legacy: get_active_context
    elif tool_name == "get_active_context":
        data = get_active_context_data(cwd=cwd, session_file=session_file, roadmap_file=roadmap_file)
        return _rpc_result(req_id, data)

    # Legacy: list_tasks
    elif tool_name == "list_tasks":
        target_roadmap = roadmap_file or find_roadmap_file(cwd=cwd)
        tasks, _ = get_open_tasks(target_roadmap) if target_roadmap else ([], [])
        project = tool_args.get("project") if isinstance(tool_args, dict) else None
        if project:
            proj_lower = str(project).strip().lower()
            tasks = [
                t for t in tasks
                if (t.get("project") and t["project"].lower() == proj_lower)
                or f"({proj_lower})" in t["text"].lower()
                or f"[{proj_lower}]" in t["text"].lower()
                or t["text"].lower().startswith(f"{proj_lower}:")
                or f"#{proj_lower}" in t["text"].lower()
            ]
        formatted = [
            {
                "id": t["id"],
                "task_num": t.get("task_num"),
                "state": t["state"],
                "state_label": t["state_label"],
                "text": t["display_text"],
                "project": t.get("project"),
            }
            for t in tasks
        ]
        return _rpc_result(req_id, formatted)

    # Legacy: set_goal
    elif tool_name == "set_goal":
        if not isinstance(tool_args, dict) or "goal" not in tool_args or not str(tool_args["goal"]).strip():
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": "Error: Missing required parameter 'goal'"}],
                    "isError": True,
                },
            }
        goal = str(tool_args["goal"]).strip()
        target_cwd = cwd or os.getcwd()
        repo_root = find_repo_root(target_cwd) or os.path.abspath(target_cwd)
        session = set_active_goal(repo_root, goal, file_path=session_file)
        pname = session.get("project_name", os.path.basename(repo_root))
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "result": {
                "content": [{"type": "text", "text": f"Active goal updated for {pname}: {goal}"}],
                "isError": False,
            },
        }

    # Legacy: update_task
    elif tool_name == "update_task":
        if not isinstance(tool_args, dict) or "id" not in tool_args or "action" not in tool_args:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": "Error: Both 'id' and 'action' parameters are required"}],
                    "isError": True,
                },
            }
        task_id = str(tool_args["id"]).strip()
        action = str(tool_args["action"]).strip().lower()
        if action not in ("start", "done", "block", "rm"):
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": f"Error: Invalid action '{action}'. Allowed: start, done, block, rm"}],
                    "isError": True,
                },
            }
        action_map = {
            "start": ("in_progress", False),
            "done": ("completed", False),
            "block": ("blocked", False),
            "rm": (None, True),
        }
        new_state, remove = action_map[action]
        success = _change_task_state(task_id=task_id, new_state=new_state, remove=remove, file_path=roadmap_file, quiet=True)
        if success:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": f"Task [{task_id}] successfully updated with action '{action}'."}],
                    "isError": False,
                },
            }
        else:
            return {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": f"Error: Task [{task_id}] not found or could not be modified."}],
                    "isError": True,
                },
            }

    else:
        return _rpc_error(req_id, -32601, f"Unknown tool: {tool_name}")


def handle_mcp_message(req, session_file=None, roadmap_file=None, cwd=None):
    """Process a single JSON-RPC 2.0 MCP message via dev_context_mcp."""
    return _load_mcp_module().handle_mcp_message(
        req,
        session_file=session_file,
        roadmap_file=roadmap_file,
        cwd=cwd,
        tool_dispatcher=handle_mcp_tool_call,
    )


def run_mcp_server(input_stream=None, output_stream=None, session_file=None, roadmap_file=None, cwd=None):
    """Run zero-dependency stdio JSON-RPC 2.0 MCP server loop via dev_context_mcp."""
    return _load_mcp_module().run_mcp_server(
        input_stream=input_stream,
        output_stream=output_stream,
        session_file=session_file,
        roadmap_file=roadmap_file,
        cwd=cwd,
        tool_dispatcher=handle_mcp_tool_call,
    )


def cmd_setup_agent(agent, is_global=False, rules_only=False):
    """
    Configure AI coding agent integrations for claude or cursor.
    """
    agent = agent.lower().strip()
    if agent == "claude":
        # 1. MCP Registration
        if not rules_only:
            claude_bin = shutil.which("claude")
            if claude_bin:
                try:
                    res = subprocess.run(
                        [claude_bin, "mcp", "add", "dev-context", "--", "dev-context", "mcp"],
                        capture_output=True,
                        text=True,
                        timeout=10,
                    )
                    if res.returncode == 0:
                        print(f"{GREEN}✓ Registered dev-context MCP server with Claude Code.{RESET}")
                    else:
                        err = res.stderr.strip() or res.stdout.strip()
                        if "already exists" in err.lower():
                            print(f"{CYAN}i dev-context MCP server already registered in Claude Code.{RESET}")
                        else:
                            print(f"{YELLOW}! Claude MCP command returned code {res.returncode}: {err}{RESET}")
                except Exception as e:
                    print(f"{YELLOW}! Failed to execute 'claude mcp add': {e}{RESET}")
            else:
                print(f"{DIM}Claude CLI not detected on PATH. Skipping automatic MCP registration.{RESET}")
                print(f"{DIM}Manual setup: claude mcp add dev-context -- dev-context mcp{RESET}")

        # 2. Write Claude rules
        cwd = os.getcwd()
        repo_root = find_repo_root(cwd) or cwd
        rules_dir = os.path.expanduser("~/.claude/rules") if is_global else os.path.join(repo_root, ".claude", "rules")
        os.makedirs(rules_dir, exist_ok=True)
        rules_file = os.path.join(rules_dir, "dev-context.md")

        rule_content = (
            "# dev-context Integration Rules\n\n"
            "At the beginning of any coding session:\n"
            "1. Inspect active workspace context and dirty repos using `dc export --agent` or `get_active_context`.\n"
            "2. Review open tasks with `dc list` or `list_tasks`.\n"
            "3. When starting work on a task, update state with `dc start <id>` or `update_task(id, 'start')`.\n"
            "4. When completing a task, update state with `dc done <id>` or `update_task(id, 'done')`.\n"
            "5. Update session goals when shifting focus with `dc goal \"<objective>\"` or `set_goal(goal)`.\n"
        )
        with open(rules_file, "w", encoding="utf-8") as f:
            f.write(rule_content)
        print(f"{GREEN}✓ Configured Claude rules:{RESET} {rules_file}")
        return True

    elif agent == "cursor":
        cwd = os.getcwd()
        repo_root = find_repo_root(cwd) or cwd
        cursor_file = os.path.expanduser("~/.cursorrules") if is_global else os.path.join(repo_root, ".cursorrules")

        cursor_rule = (
            "# dev-context Rules\n\n"
            "- Inspect pre-flight context before coding: run `dc export --agent` or `dc session`\n"
            "- Check priority sprint tasks: run `dc list`\n"
            "- Mark tasks in progress: run `dc start <id>`\n"
            "- Mark tasks completed: run `dc done <id>`\n"
            "- Record active project goals: run `dc goal \"<objective>\"`\n"
        )

        existing = ""
        if os.path.exists(cursor_file):
            with open(cursor_file, "r", encoding="utf-8") as f:
                existing = f.read()

        if "dev-context" in existing:
            print(f"{CYAN}i dev-context rules already present in:{RESET} {cursor_file}")
        else:
            with open(cursor_file, "a" if os.path.exists(cursor_file) else "w", encoding="utf-8") as f:
                if existing and not existing.endswith("\n\n"):
                    f.write("\n" if existing.endswith("\n") else "\n\n")
                f.write(cursor_rule)
            print(f"{GREEN}✓ Configured Cursor rules:{RESET} {cursor_file}")

        # Also write .cursor/rules/dev-context.mdc if .cursor directory exists
        cursor_dir = os.path.join(repo_root, ".cursor")
        if os.path.isdir(cursor_dir):
            rules_dir = os.path.join(cursor_dir, "rules")
            os.makedirs(rules_dir, exist_ok=True)
            mdc_file = os.path.join(rules_dir, "dev-context.mdc")
            with open(mdc_file, "w", encoding="utf-8") as f:
                f.write(f"---\ndescription: dev-context pre-flight and task workflow\nglobs: *\n---\n\n{cursor_rule}")
            print(f"{GREEN}✓ Configured Cursor MDC rule:{RESET} {mdc_file}")

        return True
    else:
        print(f"{RED}Unsupported agent: '{agent}'. Supported agents: claude, cursor.{RESET}")
        return False


def print_dashboard(projects_dir_override=None, max_depth=3, max_workers=None, session_file=None):
    cwd = os.getcwd()
    repo_root = find_repo_root(cwd)
    in_git = repo_root is not None

    # Auto-record session on every dashboard run when inside a git repository
    if in_git:
        record_session(repo_root, file_path=session_file)

    print(f"\n{BOLD}DEV FLIGHT CONTEXT{RESET}\n")

    # SESSION
    prev_session = get_last_session(repo_root if in_git else None, file_path=session_file)
    if prev_session:
        project = prev_session.get("project_name") or os.path.basename(prev_session.get("project_path", "unknown"))
        branch = prev_session.get("branch") or "HEAD"
        rel_time = format_rel_time(prev_session.get("last_active_timestamp"))
        goal = prev_session.get("objective") or prev_session.get("goal") or 'No goal set. Run: dc goal "..."'
        footprint = prev_session.get("footprint") or "clean"
        next_action = prev_session.get("next_action") or 'None set. Run: dc goal --next "..."'

        print(f"{BOLD}SESSION{RESET}")
        print(f"  {BOLD}Project:{RESET} {CYAN}{project}{RESET} ({branch})")
        print(f"  {BOLD}Goal:{RESET} {goal}")
        print(f"  {BOLD}Last activity:{RESET} {rel_time}")
        print(f"  {BOLD}Changes:{RESET} {footprint}")
        print(f"  {BOLD}Next:{RESET} {next_action}\n")
    else:
        print(f"{BOLD}SESSION{RESET}")
        print(f"  {DIM}No active session. Run: dc goal \"<objective>\"{RESET}\n")

    # WORKSPACE
    projects_base = projects_dir_override or os.getenv("DEV_CONTEXT_DIR", os.path.expanduser("~/Projects"))
    all_repos = scan_repositories(projects_base, max_depth=max_depth, max_workers=max_workers)

    dirty_repos = [r for r in all_repos if r[1].get("dirty_count", 0) > 0]
    print(f"{BOLD}WORKSPACE{RESET}")
    if dirty_repos:
        for name, info in dirty_repos[:6]:
            count = info["dirty_count"]
            rel_t = info["rel_time"]
            files_lbl = "file" if count == 1 else "files"
            print(f"  {CYAN}{name:<14}{RESET} {YELLOW}DIRTY · {count} {files_lbl} · {rel_t}{RESET}")
        if len(dirty_repos) > 6:
            print(f"  {DIM}... and {len(dirty_repos) - 6} more dirty repos{RESET}")
    else:
        print(f"  {DIM}(all repositories clean){RESET}")
    print()

    # FOCUS QUEUE
    roadmap_file = find_roadmap_file(cwd=cwd)
    print(f"{BOLD}FOCUS QUEUE{RESET}")
    if roadmap_file:
        tasks, _ = get_open_tasks(roadmap_file)
        if tasks:
            for t in tasks[:6]:
                badge = format_state_badge(t["state"])
                proj_tag = f"({t['project']})" if t.get("project") else ""
                print(f"  [{t['id']}] {badge}  {CYAN}{proj_tag}{RESET}")
                print(f"         {t['display_text']}")
            if len(tasks) > 6:
                print(f"  {DIM}... and {len(tasks) - 6} more tasks (run 'dev-context list'){RESET}")
        else:
            prog = os.path.basename(sys.argv[0])
            print(f"  {DIM}No pending tasks. Run '{prog} add \"...\"'{RESET}")
    else:
        print(f"  {DIM}No roadmap found. Run 'dev-context add \"...\"'{RESET}")
    print()

    # ACTIONS
    print(f"{BOLD}ACTIONS{RESET}")
    print(f"  {CYAN}dc resume{RESET}")
    print(f"  {CYAN}dc inspect <repo>{RESET}")
    print(f"  {CYAN}dc export{RESET}")
    print(f"  {CYAN}dc start/done <id>{RESET}\n")

def main():
    parser = argparse.ArgumentParser(
        description="Instant pre-flight context dashboard & task manager for terminal coding agents."
    )
    parser.add_argument("--version", "-v", action="version", version="dev-context 1.0.0")
    subparsers = parser.add_subparsers(dest="command", help="Action to perform")

    # add
    p_add = subparsers.add_parser("add", help="Add a new task to Active Sprint")
    p_add.add_argument("text", nargs="+", help="Task description")
    p_add.add_argument("-b", "--backlog", action="store_true", help="Add to Ideas Backlog instead of Sprint")
    p_add.add_argument("-l", "--local", action="store_true", help="Save to current repository ROADMAP.md")
    p_add.add_argument("-p", "--project", default=None, help="Tag task with project name")

    # idea
    p_idea = subparsers.add_parser("idea", help="Quick shortcut to add an idea to Backlog")
    p_idea.add_argument("text", nargs="+", help="Idea description")
    p_idea.add_argument("-l", "--local", action="store_true", help="Save to current repository ROADMAP.md")
    p_idea.add_argument("-p", "--project", default=None, help="Tag idea with project name")

    # done / check
    p_done = subparsers.add_parser("done", help="Check off a task by number or ID")
    p_done.add_argument("id", nargs="?", type=str, help="Task number or ID (optional)")
    p_done.add_argument("-l", "--local", action="store_true", help="Use local repo ROADMAP.md")

    # start
    p_start = subparsers.add_parser("start", help="Mark a task as in-progress")
    p_start.add_argument("id", nargs="?", type=str, help="Task number or ID (optional)")
    p_start.add_argument("-l", "--local", action="store_true", help="Use local repo ROADMAP.md")

    # block
    p_block = subparsers.add_parser("block", help="Mark a task as blocked")
    p_block.add_argument("id", nargs="?", type=str, help="Task number or ID (optional)")
    p_block.add_argument("-l", "--local", action="store_true", help="Use local repo ROADMAP.md")

    # rm
    p_rm = subparsers.add_parser("rm", help="Delete a task by number or ID")
    p_rm.add_argument("id", nargs="?", type=str, help="Task number or ID (optional)")
    p_rm.add_argument("-l", "--local", action="store_true", help="Use local repo ROADMAP.md")

    # list
    p_list = subparsers.add_parser("list", help="List all open tasks with IDs")
    p_list.add_argument("-l", "--local", action="store_true", help="List local repo tasks")
    p_list.add_argument("-p", "--project", default=None, help="Filter open tasks for a specific project")

    # goal
    p_goal = subparsers.add_parser("goal", help="Record or update the active goal for current project")
    p_goal.add_argument("text", nargs="*", help="Goal description")
    p_goal.add_argument("--next", "-n", dest="next_action", default=None, help="Next concrete action")
    p_goal.add_argument("--blocker", "-b", dest="blockers", action="append", default=None, help="Known blocker")
    p_goal.add_argument("--last-step", "-l", dest="last_step", default=None, help="Last completed step")
    p_goal.add_argument("--status", "-s", dest="status", choices=["in_progress", "blocked", "completed"], default=None, help="Session status")

    # session
    p_session = subparsers.add_parser("session", help="Display last session details")

    # resume
    p_resume = subparsers.add_parser("resume", help="Generate compact context handoff for session resumption")
    p_resume.add_argument("-p", "--project", default=None, help="Target project name or directory path")
    p_resume.add_argument("--json", action="store_true", help="Output handoff context as JSON")

    # inspect
    p_inspect = subparsers.add_parser("inspect", help="Inspect workspace repo state and session memory without cd-ing into it")
    p_inspect.add_argument("repo", help="Repository name or directory path to inspect")
    p_inspect.add_argument("--json", action="store_true", help="Output inspection as JSON")

    # export
    p_export = subparsers.add_parser("export", help="Export structured pre-flight context block for agent injection")
    p_export.add_argument("--agent", action="store_true", help="Output agent-tailored markdown briefing")
    p_export.add_argument("--json", action="store_true", help="Output JSON structure")
    p_export.add_argument("-l", "--local", action="store_true", help="Scope tasks to current repository")

    # mcp
    p_mcp = subparsers.add_parser("mcp", help="Run local Model Context Protocol (MCP) server over stdio")

    # setup-agent
    p_setup = subparsers.add_parser("setup-agent", help="Configure AI coding agent integrations")
    p_setup.add_argument("agent", choices=["claude", "cursor"], help="Target agent to configure (claude or cursor)")
    p_setup.add_argument("--global", dest="is_global", action="store_true", help="Configure globally rather than repository-local")
    p_setup.add_argument("--rules-only", action="store_true", help="Generate rules files without executing CLI commands")

    # dashboard options (default)
    parser.add_argument("--dir", "-d", default=None, help="Base projects directory to scan")
    parser.add_argument("--depth", default=3, type=int, help="Maximum directory depth to scan (default: 3)")
    parser.add_argument("--workers", default=None, type=int, help="Maximum worker threads for scanning")

    args = parser.parse_args()

    if args.command == "add":
        section = "## Ideas Backlog" if args.backlog else "## Active Sprint"
        cmd_add(" ".join(args.text), section=section, local=args.local, project=args.project)
    elif args.command == "idea":
        cmd_add(" ".join(args.text), section="## Ideas Backlog", local=args.local, project=args.project)
    elif args.command == "done":
        cmd_done(task_id=args.id, remove=False, local=args.local)
    elif args.command == "start":
        cmd_start(task_id=args.id, local=args.local)
    elif args.command == "block":
        cmd_block(task_id=args.id, local=args.local)
    elif args.command == "rm":
        cmd_done(task_id=args.id, remove=True, local=args.local)
    elif args.command == "list":
        cmd_list(local=args.local, project=args.project)
    elif args.command == "goal":
        goal_text = " ".join(args.text).strip() if args.text else None
        cmd_goal(
            text=goal_text,
            next_action=args.next_action,
            blockers=args.blockers,
            last_step=args.last_step,
            status=args.status
        )
    elif args.command == "session":
        cmd_session()
    elif args.command == "resume":
        cmd_resume(project=args.project, as_json=args.json)
    elif args.command == "inspect":
        cmd_inspect(args.repo, as_json=args.json)
    elif args.command == "export":
        cmd_export(agent=args.agent, as_json=args.json, local=args.local)
    elif args.command == "mcp":
        run_mcp_server()
    elif args.command == "setup-agent":
        cmd_setup_agent(args.agent, is_global=args.is_global, rules_only=args.rules_only)
    else:
        print_dashboard(
            projects_dir_override=args.dir,
            max_depth=args.depth,
            max_workers=args.workers
        )

if __name__ == "__main__":
    main()
